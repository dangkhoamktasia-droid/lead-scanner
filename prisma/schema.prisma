generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366F1")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups       Group[]
  leads        Lead[]
  scanSessions ScanSession[]
}

model Group {
  id            String    @id @default(cuid())
  name          String
  url           String    @unique
  enabled       Boolean   @default(true)
  priority      Int       @default(0)
  jobId         String?
  job           Job?      @relation(fields: [jobId], references: [id])
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rawPosts         RawPost[]
  scanGroupResults ScanGroupResult[]
}

model ScanSession {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  status          String    @default("RUNNING")
  jobId           String?
  job             Job?      @relation(fields: [jobId], references: [id])
  scanDays        Int       @default(2)
  resultLimit     Int       @default(30)
  totalGroups     Int       @default(0)
  successGroups   Int       @default(0)
  failedGroups    Int       @default(0)
  totalPosts      Int       @default(0)
  totalLeads      Int       @default(0)
  totalDuplicated Int       @default(0)
  totalRejected   Int       @default(0)
  apifyRunId      String?
  apifyCostUsd    Float?
  aiCostUsd       Float?
  errorMessage    String?

  rawPosts         RawPost[]
  leads            Lead[]
  scanGroupResults ScanGroupResult[]
}

model ScanGroupResult {
  id            String   @id @default(cuid())
  scanSessionId String
  groupId       String
  status        String   @default("PENDING")
  postsFound    Int      @default(0)
  leadsFound    Int      @default(0)
  errorMessage  String?
  createdAt     DateTime @default(now())

  scanSession ScanSession @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model RawPost {
  id            String   @id @default(cuid())
  scanSessionId String
  groupId       String
  postText      String
  postUrl       String
  facebookUrl   String?
  userName      String?
  userId        String?
  rawJson       String
  createdAt     DateTime @default(now())

  scanSession ScanSession @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lead        Lead?
}

model Lead {
  id             String    @id @default(cuid())
  scanSessionId  String
  jobId          String?
  job            Job?      @relation(fields: [jobId], references: [id])
  rawPostId      String    @unique
  userName       String?
  userProfileUrl String?
  postUrl        String?
  postText       String
  hinhThucCast   String?
  sanPhamDichVu  String?
  soLuongCanBook String?
  sdtLienHe      String?
  message        String?
  confidence     Float     @default(0)
  reason         String?
  rejectReason   String?
  fingerprint    String?
  status         String    @default("RAW")
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  scanSession ScanSession @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)
  rawPost     RawPost     @relation(fields: [rawPostId], references: [id], onDelete: Cascade)
  syncLogs    SyncLog[]

  @@index([fingerprint])
  @@index([status])
  @@index([scanSessionId, status])
}

model SyncLog {
  id           String   @id @default(cuid())
  leadId       String
  sheetRow     Int?
  status       String   @default("SUCCESS")
  errorMessage String?
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
